 # NOTE(sgm): this implementation only consider outcome supervision, where the reward is a scalar.
+# zkx-ngrpo-runtime-patch-v1
+@register_adv_est("ngrpo")
+def compute_ngrpo_outcome_advantage(
+    token_level_rewards: torch.Tensor,
+    response_mask: torch.Tensor,
+    index: np.ndarray,
+    epsilon: float = 1e-6,
+    config: Optional[AlgoConfig] = None,
+    **kwargs,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """NGRPO outcome advantage using predecessor virtual max-reward samples."""
+    if config is None:
+        raise ValueError("NGRPO requires algorithm config")
+    max_reward = float(config.get("max_reward", 1.0))
+    add_max_reward_num = int(config.get("add_max_reward_num", 1))
+    if add_max_reward_num < 1:
+        raise ValueError("algorithm.add_max_reward_num must be >= 1")
+
+    scores = token_level_rewards.sum(dim=-1)
+    group_scores = defaultdict(list)
+    group_mean = {}
+    group_std = {}
+    with torch.no_grad():
+        for sample_index in range(scores.shape[0]):
+            group_scores[index[sample_index]].append(scores[sample_index])
+        for group_id, values in group_scores.items():
+            values_tensor = torch.stack(values)
+            virtual_scores = torch.full(
+                (add_max_reward_num,),
+                max_reward,
+                dtype=values_tensor.dtype,
+                device=values_tensor.device,
+            )
+            augmented = torch.cat((values_tensor, virtual_scores))
+            group_mean[group_id] = augmented.mean()
+            group_std[group_id] = augmented.std()
+        normalized = torch.stack([
+            (scores[sample_index] - group_mean[index[sample_index]])
+            / (group_std[index[sample_index]] + epsilon)
+            for sample_index in range(scores.shape[0])
+        ])
+        advantages = normalized.unsqueeze(-1) * response_mask
+    return advantages, advantages
+
+
 @register_adv_est(AdvantageEstimator.GRPO)  # or simply: @register_adv_est("grpo")
